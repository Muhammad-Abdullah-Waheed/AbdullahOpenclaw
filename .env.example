# Get a free Gemini API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# If you switch `agent.py` to a Groq model via $LLM_MODEL, set this instead/also:
# GROQ_API_KEY=your-groq-key-here
#
# Optional: force a single key regardless of provider (overrides the provider-specific key logic):
# LLM_API_KEY=...

# Model selection for litellm. If unset, the code defaults to Gemini.
# Examples:
#   LLM_MODEL=gemini/gemini-flash-latest
#   LLM_MODEL=groq/openai/some-groq-model
LLM_MODEL=gemini/gemini-flash-latest

# How long a single `completion()` call is allowed to take (seconds) before it fails fast.
LLM_TIMEOUT_SECONDS=60

# Log verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- Skills (Stage 3) ---
# Each skill lives at: default_workspace/skills/<id>/SKILL.md (YAML frontmatter + markdown body).
#
# Attachment modes:
# - always: only skills listed in SKILL_ALWAYS are attached (constant system prompt)
# - auto: scan SKILL_POOL (or all discovered skills) and attach skills whose `keywords:` match the user text
# - both: SKILL_ALWAYS + auto matches
SKILL_ATTACH_MODE=always
#
# Examples:
# SKILL_ATTACH_MODE=both
# SKILL_ALWAYS=study-tutor
# SKILL_POOL=study-tutor,code-helper
#
# Back-compat (Lesson 1): if SKILL_ALWAYS/SKILL_POOL are unset, SKILL_IDS is used as:
# - always-list when SKILL_ATTACH_MODE=always
# - pool-list when SKILL_ATTACH_MODE is auto/both
SKILL_IDS=study-tutor

# Optional: gate auto-selected skills to those whose `profiles:` intersect this list (comma-separated).
# If unset/empty, profile gating is disabled (skills without `profiles:` remain eligible everywhere).
# SKILL_PROFILES=student,dev

# Optional: override the workspace root (defaults to ./default_workspace next to the code)
# WORKSPACE_DIR=/abs/path/to/workspace

# --- Sessions (Stage 4) ---
# Transcript JSON: <WORKSPACE_DIR or default_workspace>/sessions/<SESSION_ID>.json
# SESSION_ID=default
# SESSION_PERSIST=1
# Set SESSION_PERSIST=0 to run without loading/saving (ephemeral chat).

# --- Slash commands (Stage 5) ---
# In the REPL, lines starting with / are handled locally (see slash_commands.py): /help, /new, /session, …

# --- Compaction (Stage 6) ---
# When JSON-serialized messages exceed ~COMPACTION_CHAR_BUDGET, oldest middle is replaced by a summary user message.
# COMPACTION_ENABLED=1
# COMPACTION_CHAR_BUDGET=120000
# COMPACTION_KEEP_LAST_MESSAGES=24
# COMPACTION_MIN_KEEP_MESSAGES=6
# COMPACTION_SUMMARIZE=0
# COMPACTION_SUMMARY_MODEL=
#   (if COMPACTION_SUMMARIZE=1, defaults to LLM_MODEL; set to a cheap model if you prefer)
